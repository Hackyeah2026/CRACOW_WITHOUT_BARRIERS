@page "/profil"
@inject AppState State
@inject NavigationManager Navigation

<PageTitle>Profil potrzeb</PageTitle>

<div class="profile-hero">
    <div class="container">
        <h1>@(State.User is null ? "Dostosuj profil potrzeb" : "Twój profil potrzeb")</h1>
        <p class="hero-subtext">Pytamy o to, czego potrzebujesz, a nie o diagnozę. Możesz wybrać kilka profili naraz, a potem zmienić każdy parametr.</p>
    </div>
</div>

<div class="container py-5">
    @if (!_loaded)
    {
        <p role="status">Wczytuję…</p>
    }
    else if (State.User is { } user)
    {
        <section class="card card-body" aria-labelledby="saved-profile-heading">
            <h2 id="saved-profile-heading" class="h4">Profil zapisany dla konta @user.Login</h2>
            <ProfileOverview />
            <p class="text-body-secondary mt-3">
                @(State.Profile.IsEmpty
                    ? "Ustaw profil, żeby oceny miejsc i trasy były dopasowane do Ciebie."
                    : "Według tego profilu oceniamy miejsca i układamy trasy.")
                Profil jest zapisany na tym urządzeniu i przypisany do Twojego konta; nie wysyłamy go na serwer.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary btn-lg" href="konto/profil">@(State.Profile.IsEmpty ? "Ustaw profil" : "Edytuj profil")</a>
                <a class="btn btn-outline-secondary btn-lg" href="miejsca">Pokaż miejsca</a>
            </div>
        </section>
    }
    else
    {
        <div class="alert alert-info" role="note">
            <strong>Konfiguracja tymczasowa.</strong> Bez konta profil działa tylko w tej przeglądarce.
            <a class="alert-link" href="konto?powrot=profil">Zaloguj się albo załóż konto</a>, żeby zapisać go dla konta
            i edytować ze strony Konto; ustawienia wybrane tutaj przejdą na nowe konto.
        </div>
        <ProfileEditor SaveLabel="✓ Gotowe, pokaż miejsca" OnSaved="@(() => Navigation.NavigateTo("miejsca"))"
                       Note="Konfiguracja tymczasowa zostaje w tej przeglądarce. Nie wysyłamy jej na serwer." />
    }
</div>

@code {
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        await State.EnsureLoadedAsync();
        _loaded = true;
    }
}
