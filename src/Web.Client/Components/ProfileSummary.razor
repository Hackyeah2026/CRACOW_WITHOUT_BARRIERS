@implements IDisposable
@inject AppState State

@if (Shown.IsEmpty)
{
    <p class="mb-0">Profil nie jest ustawiony. Bez niego nie pokażemy oceny dopasowanej do Ciebie.</p>
}
else
{
    <p class="mb-0">
        @if (Names.Count > 0)
        {
            <strong>@string.Join(", ", Names)</strong>
        }
        else
        {
            <strong>Profil własny</strong>
        }
    </p>
}

@code {
    protected override void OnInitialized() => State.Changed += StateHasChanged;

    public void Dispose() => State.Changed -= StateHasChanged;

    /// <summary>Profil do pokazania zamiast zapisanego, np. niezapisane jeszcze zmiany w edytorze.</summary>
    [Parameter] public NeedsProfile? Profile { get; set; }

    private NeedsProfile Shown => Profile ?? State.Profile;

    private List<string> Names => NeedsProfilePresets.All
        .Where(p => Shown.Presets.Contains(p.Id)).Select(p => p.Name).ToList();
}
