@implements IAsyncDisposable
@inject IJSRuntime JS

@* Natywny <dialog> otwierany jako modalny: przeglądarka sama pilnuje fokusu, klawisza Esc i tła. *@
<dialog @ref="_dialog" class="kbb-dialog" aria-labelledby="@_titleId">
    <h2 id="@_titleId">@Title</h2>
    <p class="mb-0">@ChildContent</p>
    <div class="kbb-dialog-actions">
        <button type="button" class="btn btn-link" @onclick="CloseAsync">@CancelLabel</button>
        <button type="button" class="btn btn-primary" @onclick="ConfirmAsync">@ConfirmLabel</button>
    </div>
</dialog>

@code {
    private readonly string _titleId = $"dialog-{Guid.NewGuid():N}";
    private ElementReference _dialog;
    private IJSObjectReference? _module;

    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string ConfirmLabel { get; set; } = "";
    [Parameter] public string CancelLabel { get; set; } = "Anuluj";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    public async Task ShowAsync()
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/dialog.js");
        await _module.InvokeVoidAsync("show", _dialog);
    }

    private async Task CloseAsync()
    {
        if (_module is not null)
            await _module.InvokeVoidAsync("close", _dialog);
    }

    private async Task ConfirmAsync()
    {
        await CloseAsync();
        await OnConfirm.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
