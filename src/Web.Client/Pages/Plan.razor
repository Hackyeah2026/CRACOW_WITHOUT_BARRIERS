@page "/plan"
@inject AppState State
@inject ISender Sender
@inject IJSRuntime JS

<PageTitle>Plan</PageTitle>

<div class="page-header" data-tour="plan-intro">
    <h1>Plan: @(State.User is null ? Labels.Of(State.Mode) : State.ActivePlan?.Name ?? "moje plany")</h1>
    <p>Profil: <ProfileSummaryInline /> · <a href="profil">zmień</a></p>
</div>

<CoverageNotice />

@if (_selected is not null && State.User is not null)
{
    <section class="card card-body mb-3" aria-labelledby="plans-heading">
        <h2 id="plans-heading" class="h5">Moje plany</h2>
        @if (State.PlansError is not null)
        {
            <div class="alert alert-warning" role="alert">@State.PlansError</div>
        }
        else if (State.Plans.Count == 0)
        {
            <p>Nie masz jeszcze żadnego planu. Nazwij pierwszy poniżej albo dodaj miejsce z <a href="miejsca">listy miejsc</a>.</p>
        }
        else
        {
            <ul class="list-unstyled place-list">
                @foreach (var plan in State.Plans)
                {
                    var active = plan.Id == State.ActivePlan?.Id;
                    <li class="place-item">
                        <div>
                            <span class="place-name">@plan.Name</span>
                            <span class="status-badge @Labels.Css(plan.Status)">@Labels.Of(plan.Status)</span>
                            @if (active)
                            {
                                <span class="badge text-bg-light border ms-1">Otwarty</span>
                            }
                            <div class="small text-body-secondary">
                                @plan.PlaceIds.Count @Labels.PlacesWord(plan.PlaceIds.Count) · zmieniony @Labels.When(plan.UpdatedAt)
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-2 justify-content-end">
                            <button type="button" class="btn btn-outline-primary" disabled="@(active || _busy)"
                                    aria-label="Otwórz plan: @plan.Name" @onclick="() => OpenPlanAsync(plan.Id)">Otwórz</button>
                            <button type="button" class="btn btn-outline-danger" disabled="@_busy"
                                    aria-label="Usuń plan: @plan.Name" @onclick="() => AskDeleteAsync(plan)">Usuń</button>
                        </div>
                    </li>
                }
            </ul>
        }
        <form @onsubmit="CreatePlanAsync" @onsubmit:preventDefault novalidate>
            <label class="form-label" for="new-plan-name">Nowy plan</label>
            <div class="d-flex flex-wrap gap-2">
                <input id="new-plan-name" class="form-control plan-name-input" maxlength="@SavedPlanDraft.MaxNameLength"
                       placeholder="np. Sobota na Kazimierzu" @bind="_newPlanName" />
                <button type="submit" class="btn btn-outline-primary" disabled="@_busy">Utwórz plan</button>
            </div>
        </form>
        @if (_plansError is not null)
        {
            <div class="alert alert-danger mt-3 mb-0" role="alert">@_plansError</div>
        }
    </section>
}

@if (_selected is null)
{
    <div class="text-center py-4" role="status">
        <div class="spinner-border text-primary mb-2" aria-hidden="true"></div>
        <p>Wczytuję wybrane miejsca…</p>
    </div>
}
else if (State.User is not null && State.ActivePlan is null)
{
    @if (State.Plans.Count > 0)
    {
        <p>Otwórz plan z listy albo utwórz nowy.</p>
    }
}
else if (IsClosed)
{
    <div class="alert alert-info" role="note">
        <strong>Ten plan jest zamknięty.</strong> Trasa została zapisana @Labels.When(State.ActivePlan!.UpdatedAt) i planu nie można już edytować:
        nie dodasz ani nie usuniesz miejsc i nie zmienisz kolejności. Możesz go usunąć albo utworzyć nowy plan.
    </div>
    @if (_loadingRoute)
    {
        <p role="status">Wczytuję zapisaną trasę…</p>
    }
}
else if (_selected.Count == 0)
{
    <p>Plan jest pusty. <a href="miejsca">Wybierz miejsca</a>, które chcesz odwiedzić.</p>
}
else
{
    <h2 class="h5">Wybrane miejsca (@_selected.Count)</h2>
    <p class="small text-body-secondary">
        @(State.StartLocation is null ? "Pierwsze miejsce na liście jest punktem startu." : "Startem jest punkt wskazany na mapie.")
        @(State.OptimizeOrder
            ? "Kolejność pozostałych ułożymy tak, żeby droga była najkrótsza."
            : "Pozostałe miejsca odwiedzisz w kolejności z listy.")
        Strzałkami zmienisz kolejność.
    </p>
    <ol class="list-unstyled place-list" data-tour="plan-list">
        @if (State.StartLocation is not null)
        {
            <li class="place-item">
                <div>
                    <span class="place-name"><span class="msym" aria-hidden="true">location_on</span> @StartLocationRules.Name</span>
                    <span class="badge text-bg-success ms-1">Start</span>
                    <div class="small text-body-secondary">Możesz go poprawić na mapie poniżej. Używamy go tylko do ułożenia tego planu i nie zapisujemy.</div>
                </div>
                <button type="button" class="btn btn-outline-danger" disabled="@_building" @onclick="RemoveStartLocation">Usuń<span class="visually-hidden"> punkt startu</span></button>
            </li>
        }
        @for (var i = 0; i < _selected.Count; i++)
        {
            var item = _selected[i];
            var index = i;
            <li class="place-item">
                <div>
                    <a class="place-name" href="miejsca/@item.Place.Id">@item.Place.Name</a>
                    @if (index == 0 && State.StartLocation is null)
                    {
                        <span class="badge text-bg-success ms-1">Start</span>
                    }
                    <div><AssessmentBadge Status="item.Assessment.Status" /></div>
                </div>
                <div class="d-flex flex-wrap gap-2 justify-content-end">
                    <button type="button" class="btn btn-outline-secondary btn-move" disabled="@(index == 0 || _building)"
                            aria-label="Przesuń wyżej: @item.Place.Name" @onclick="() => MoveAsync(item, -1)"><span class="msym" aria-hidden="true">arrow_upward</span></button>
                    <button type="button" class="btn btn-outline-secondary btn-move" disabled="@(index == _selected.Count - 1 || _building)"
                            aria-label="Przesuń niżej: @item.Place.Name" @onclick="() => MoveAsync(item, 1)"><span class="msym" aria-hidden="true">arrow_downward</span></button>
                    <button type="button" class="btn btn-outline-danger" disabled="@_building" aria-label="Usuń z planu: @item.Place.Name" @onclick="() => RemoveAsync(item.Place.Id)">Usuń</button>
                </div>
            </li>
        }
    </ol>
    <p class="visually-hidden" role="status">@_moveStatus</p>

    <div class="form-check mb-3">
        <input id="optimize-order" class="form-check-input" type="checkbox" checked="@State.OptimizeOrder" disabled="@_building" @onchange="SetOptimizeAsync" />
        <label class="form-check-label" for="optimize-order">Ułóż kolejność automatycznie (najkrótsza droga)</label>
    </div>

    <div class="plan-actions mb-3" data-tour="plan-actions">
        <button type="button" class="btn btn-primary btn-lg" disabled="@(!CanBuild || _building)" @onclick="BuildAsync">
            @if (_building)
            {
                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                <span>Układam plan…</span>
            }
            else
            {
                <span>Ułóż plan</span>
            }
        </button>
        <button type="button" class="btn btn-outline-primary btn-lg" disabled="@(_locating || _building)" @onclick="UseMyLocationAsync">
            @if (_locating)
            {
                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                <span>Ustalam lokalizację…</span>
            }
            else
            {
                <span class="msym" aria-hidden="true">my_location</span><span>Użyj mojej lokalizacji jako start</span>
            }
        </button>
        @if (!ShowStartPicker)
        {
            <button type="button" class="btn btn-outline-primary btn-lg" disabled="@_building" @onclick="() => _pickingStart = true">
                <span class="msym" aria-hidden="true">map</span> Wskaż start na mapie
            </button>
        }
        <button type="button" class="btn btn-outline-secondary btn-lg" disabled="@_building" @onclick="() => _confirmClear!.ShowAsync()">Wyczyść plan</button>
    </div>
    @if (_locationError is not null)
    {
        <div class="alert alert-warning" role="alert">@_locationError</div>
    }
    @if (ShowStartPicker)
    {
        <section class="card card-body mb-3" aria-labelledby="start-heading">
            <h3 id="start-heading" class="h6">Punkt startu na mapie</h3>
            <p class="small mb-2">
                @(State.StartLocation is null
                    ? "Kliknij na mapie miejsce, z którego zaczynasz."
                    : "Sprawdź, czy pinezka stoi tam, gdzie jesteś. Żeby ją poprawić albo wybrać inny punkt, przeciągnij ją lub kliknij w inne miejsce mapy.")
                Z klawiatury: przejdź do pinezki klawiszem Tab i przesuwaj ją strzałkami.
            </p>
            <MapView Label="Mapa wyboru punktu startu" Center="CityCenter" Zoom="@(State.City?.Zoom ?? 14)" Markers="_pickerMarkers" FitToMarkers="true"
                     PickPoint="State.StartLocation" OnPointPicked="SetStartPoint" />
            <p class="small mt-2 mb-0" role="status">
                @(State.StartLocation is { } start
                    ? $"Punkt startu: {start.Lat:F5}, {start.Lon:F5}."
                    : "Punkt startu nie jest jeszcze wybrany.")
            </p>
        </section>
    }
    @if (!CanBuild)
    {
        <p>Dodaj co najmniej dwa miejsca albo ustaw punkt startu, żeby ułożyć plan.</p>
    }
}

<ConfirmDialog @ref="_confirmClear" Title="Wyczyścić plan?" ConfirmLabel="Wyczyść plan" OnConfirm="ClearAsync">
    Usuniemy z planu wszystkie wybrane miejsca i punkt startu.
</ConfirmDialog>

<ConfirmDialog @ref="_confirmDelete" Title="Usunąć plan?" ConfirmLabel="Usuń plan" OnConfirm="DeletePlanAsync">
    Usuniemy plan „@_deleting?.Name”@(_deleting is { IsClosed: true } ? " razem z zapisaną trasą" : ""). Tego nie da się cofnąć.
</ConfirmDialog>

<ConfirmDialog @ref="_confirmClose" Title="Zapisać trasę i zamknąć plan?" ConfirmLabel="Zapisz i zamknij" OnConfirm="ClosePlanAsync">
    Zapiszemy tę trasę w planie „@State.ActivePlan?.Name” na Twoim koncie. Po zapisaniu planu nie będzie można edytować:
    nie dodasz ani nie usuniesz miejsc i nie zmienisz kolejności. Zamknięty plan możesz otworzyć albo usunąć.
    @if (State.StartLocation is not null)
    {
        <text> Razem z trasą zapiszemy na serwerze wskazany punkt startu.</text>
    }
</ConfirmDialog>

@if (_building)
{
    <div class="text-center py-4" role="status">
        <div class="spinner-border text-primary mb-2" aria-hidden="true"></div>
        <p>Układam plan: liczę trasy po ulicach i sprawdzam komunikację miejską…</p>
    </div>
}

@if (_error is not null)
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

@if (_plan is not null)
{
    <section aria-labelledby="plan-heading">
        <h2 id="plan-heading" class="h4" tabindex="-1">@(IsClosed ? "Zapisana trasa" : "Twój plan")</h2>
        <p role="status">
            @_plan.Stops.Count przystanków, około @Labels.Distance(_plan.TotalDistanceM) drogi,
            około @Math.Ceiling(_plan.TotalDurationMin) min w ruchu (bez czasu na miejscu).
            @if (_hazards.Count > 0)
            {
                <text>Przy trasie: @_hazards.Count @(_hazards.Count == 1 ? "utrudnienie potwierdzone" : "utrudnień potwierdzonych") przez urząd, z tego dla Twojego profilu: @_hazards.Count(h => h.ConcernsProfile).</text>
            }
        </p>
        @if (State.ActivePlan is { IsClosed: false })
        {
            <div class="card card-body mb-3">
                <p class="mb-2">
                    Trasa jest gotowa? Zapisz ją na koncie. <strong>Zapis zamyka plan: potem nie można go już edytować.</strong>
                </p>
                <div>
                    <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="() => _confirmClose!.ShowAsync()">
                        <span class="msym" aria-hidden="true">save</span> Zapisz trasę i zamknij plan
                    </button>
                </div>
            </div>
        }

        <div class="row g-3">
            <div class="col-lg-6">
                <ol class="list-unstyled">
                    @for (var i = 0; i < _plan.Stops.Count; i++)
                    {
                        var stop = _plan.Stops[i];
                        <li class="card card-body mb-2">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span class="stop-number @StopCss(i, _plan.Stops.Count)" aria-hidden="true">@stop.Order</span>
                                @if (stop.IsUserLocation)
                                {
                                    <span class="place-name"><span class="visually-hidden">Przystanek @stop.Order: </span><span class="msym" aria-hidden="true">location_on</span> @stop.Place.Name</span>
                                }
                                else
                                {
                                    <a class="place-name" href="miejsca/@stop.Place.Id"><span class="visually-hidden">Przystanek @stop.Order: </span>@stop.Place.Name</a>
                                }
                                @if (StopRole(i, _plan.Stops.Count) is { } role)
                                {
                                    <span class="badge text-bg-light border">@role</span>
                                }
                                @if (!stop.IsUserLocation)
                                {
                                    <AssessmentBadge Status="stop.Assessment.Status" />
                                }
                            </div>
                            @foreach (var barrier in stop.IsUserLocation ? [] : stop.Assessment.Barriers)
                            {
                                <div class="small mt-1"><span class="msym msym-fill reason-icon-cancel" aria-hidden="true">cancel</span> @barrier.Message</div>
                            }
                            @if (!stop.IsUserLocation && stop.Assessment.Status == AssessmentStatus.Unknown)
                            {
                                <div class="small mt-1"><span class="msym reason-icon-help" aria-hidden="true">help</span> Nie mamy danych, żeby ocenić to miejsce dla Twojego profilu.</div>
                            }
                        </li>
                        @if (i < _plan.Legs.Count)
                        {
                            var leg = _plan.Legs[i];
                            <li class="leg">
                                <span class="msym" aria-hidden="true">directions_walk</span> @(leg.IsEstimated ? "około " : "")@Labels.Distance(leg.DistanceM), około @Math.Ceiling(leg.DurationMin) min
                                @foreach (var warning in leg.Warnings.Where(w => !w.StartsWith("Dystans szacowany")))
                                {
                                    <div class="text-warning-emphasis"><span class="msym" aria-hidden="true">warning</span> @warning</div>
                                }
                                @foreach (var hazard in leg.Hazards ?? [])
                                {
                                    <div class="hazard-note @(hazard.ConcernsProfile ? "hazard-concerns" : "")">
                                        <span class="msym" aria-hidden="true">@Labels.Icon(hazard.Hazard.Kind)</span>
                                        W tym miejscu jest @Labels.Verified(hazard.Hazard).ToLowerInvariant()
                                        (@(hazard.DistanceM < 10 ? "na trasie" : $"około {Labels.Distance(hazard.DistanceM)} od trasy"), potwierdzone @hazard.Hazard.VerifiedOn.ToString("dd.MM.yyyy")).
                                        @if (hazard.ConcernsProfile)
                                        {
                                            <strong>Dotyczy Twojego profilu.</strong>
                                        }
                                        @if (!string.IsNullOrEmpty(hazard.Hazard.Description))
                                        {
                                            <div class="report-description">„@hazard.Hazard.Description”</div>
                                        }
                                    </div>
                                }
                                @if (leg.RestStops is { Count: > 0 } rests)
                                {
                                    <div class="hazard-note">
                                        <span class="msym" aria-hidden="true">chair</span>
                                        @(rests.Count == 1 ? "Ławka na przerwę" : "Ławki na przerwę") przy trasie:
                                        @string.Join(", ", rests.Select(r => $"po około {Labels.Distance(r.DistanceFromStartM)}")) marszu od początku odcinka.
                                    </div>
                                }
                                @if (leg.Transit is not null)
                                {
                                    <TransitPanel Advice="leg.Transit" />
                                }
                            </li>
                        }
                    }
                </ol>
                @if (_plan.Legs.Any(l => l.IsEstimated))
                {
                    <div class="alert alert-info" role="note">
                        Nie udało się pobrać trasy po ulicach dla części odcinków. Ich dystans jest szacowany w linii prostej, a bariery po drodze nie są sprawdzone.
                    </div>
                }
            </div>
            <div class="col-lg-6">
                <MapView Label="Mapa planu" Markers="_markers" Route="_route" FitToMarkers="true" />
                <ul class="map-legend list-unstyled small mt-2" aria-label="Legenda mapy">
                    <li><span class="map-legend-pin stop-start" aria-hidden="true"></span> start</li>
                    <li><span class="map-legend-pin" aria-hidden="true"></span> przystanek po drodze</li>
                    <li><span class="map-legend-pin stop-end" aria-hidden="true"></span> cel</li>
                    <li><span class="map-legend-line map-legend-walk" aria-hidden="true"></span> pieszo</li>
                    @if (_hazards.Count > 0)
                    {
                        <li><span class="msym" aria-hidden="true">warning</span> utrudnienie potwierdzone przez urząd</li>
                    }
                    @if (_plan.Legs.Any(l => l.RestStops is { Count: > 0 }))
                    {
                        <li><span class="msym" aria-hidden="true">chair</span> ławka na przerwę w marszu</li>
                    }
                    @if (_route.Any(r => r.IsTransit))
                    {
                        <li><span class="map-legend-line map-legend-transit" aria-hidden="true"></span> propozycja przejazdu komunikacją miejską</li>
                    }
                </ul>
            </div>
        </div>
    </section>
}

@code {
    // Te same kolory co --kbb-color-map-* w tokens.css (legenda pod mapą).
    private const string StartColor = "#146C2E";
    private const string MiddleColor = "#0B4F8A";
    private const string EndColor = "#BA1A1A";
    private const string RestColor = "#5C5F66";

    private List<AssessedPlace>? _selected;
    private TripPlan? _plan;
    private IReadOnlyList<MapMarker> _markers = [];
    private IReadOnlyList<MapRouteSegment> _route = [];
    private IReadOnlyList<HazardOnRoute> _hazards = [];
    private string? _error;
    private string? _locationError;
    private string? _moveStatus;
    private bool _building;
    private bool _locating;

    private bool _pickingStart;
    private bool _busy;
    private bool _loadingRoute;
    private string _newPlanName = "";
    private string? _plansError;
    private SavedPlan? _deleting;
    private ConfirmDialog? _confirmClear;
    private ConfirmDialog? _confirmDelete;
    private ConfirmDialog? _confirmClose;
    private IReadOnlyList<MapMarker> _pickerMarkers = [];

    private bool ShowStartPicker => _pickingStart || State.StartLocation is not null;

    private GeoPoint CityCenter => State.City is { } city ? new GeoPoint(city.Lat, city.Lon) : new GeoPoint(50.0614, 19.9366);

    private bool IsClosed => State.ActivePlan is { IsClosed: true };

    private bool CanBuild => _selected is not null && _selected.Count >= (State.StartLocation is null ? 2 : 1);

    protected override async Task OnInitializedAsync()
    {
        await State.EnsureLoadedAsync();
        await ReloadAsync();
    }

    /// <summary>Po zmianie otwartego planu: miejsca planu w przygotowaniu albo zapisana trasa planu zamkniętego.</summary>
    private async Task ReloadAsync()
    {
        (_plan, _error, _locationError, _pickingStart) = (null, null, null, false);
        await LoadSelectedAsync();
        if (State.ActivePlan is not { IsClosed: true } closed)
            return;

        _loadingRoute = true;
        StateHasChanged();
        var route = await Sender.Send(new GetSavedRouteQuery(closed.Id, State.Profile));
        _loadingRoute = false;
        if (route.IsSuccess)
            ShowPlan(route.Value);
        else
            _error = route.Error;
    }

    private async Task OpenPlanAsync(string planId)
    {
        _plansError = null;
        await State.SelectPlanAsync(planId);
        await ReloadAsync();
    }

    private async Task CreatePlanAsync()
    {
        if (_busy)
            return;

        _busy = true;
        var result = await State.CreatePlanAsync(_newPlanName.Trim());
        _busy = false;
        _plansError = result.Error;
        if (result.IsSuccess)
        {
            _newPlanName = "";
            await ReloadAsync();
        }
    }

    private async Task AskDeleteAsync(SavedPlan plan)
    {
        _deleting = plan;
        await _confirmDelete!.ShowAsync();
    }

    private async Task DeletePlanAsync()
    {
        if (_deleting is not { } plan || _busy)
            return;

        _busy = true;
        var wasActive = plan.Id == State.ActivePlan?.Id;
        var result = await State.DeletePlanAsync(plan.Id);
        _busy = false;
        _plansError = result.Error;
        if (result.IsSuccess && wasActive)
            await ReloadAsync();
    }

    private async Task ClosePlanAsync()
    {
        if (_plan is not { } route || _busy)
            return;

        _busy = true;
        var result = await State.ClosePlanAsync(route);
        _busy = false;
        _error = result.Error;
        if (result.IsSuccess)
            await LoadSelectedAsync();
    }

    private async Task LoadSelectedAsync()
    {
        var selected = new List<AssessedPlace>();
        // Zamknięty plan pokazuje zapisaną trasę, a nie listę do edycji.
        foreach (var id in IsClosed ? [] : State.PlanPlaceIds)
        {
            var result = await Sender.Send(new GetPlaceDetailsQuery(State.CityId, id, State.Profile));
            if (result.IsSuccess)
                selected.Add(result.Value);
        }
        _selected = selected;
        _pickerMarkers = selected
            .Select(p => new MapMarker(p.Place.Id, p.Place.Name, p.Place.Lat, p.Place.Lon, Labels.Color(p.Assessment.Status)))
            .ToList();
    }

    /// <summary>Start wskazany lub poprawiony na mapie.</summary>
    private void SetStartPoint(GeoPoint point)
    {
        State.SetStartLocation(point);
        _plan = null;
        _error = null;
    }

    private async Task RemoveAsync(string id)
    {
        _error = (await State.TogglePlaceAsync(id)).Error;
        _plan = null;
        await LoadSelectedAsync();
    }

    private async Task MoveAsync(AssessedPlace item, int offset)
    {
        _error = (offset < 0 ? await State.MovePlaceUpAsync(item.Place.Id) : await State.MovePlaceDownAsync(item.Place.Id)).Error;

        // Ułożony plan przestaje odpowiadać liście, więc go chowamy.
        _plan = null;
        await LoadSelectedAsync();
        _moveStatus = $"{item.Place.Name}: pozycja {_selected!.FindIndex(p => p.Place.Id == item.Place.Id) + 1} z {_selected.Count}.";
    }

    private async Task SetOptimizeAsync(ChangeEventArgs e)
    {
        await State.SetOptimizeOrderAsync(e.Value is true);
        _plan = null;
    }

    private async Task UseMyLocationAsync()
    {
        _locating = true;
        _locationError = null;
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/geolocation.js");
            var position = await module.InvokeAsync<Position>("getCurrentPosition");
            if (position.Ok)
            {
                State.SetStartLocation(new GeoPoint(position.Lat, position.Lon));
                _plan = null;
            }
            else
            {
                _locationError = position.Reason switch
                {
                    "denied" => "Przeglądarka nie ma zgody na lokalizację. Włącz ją w ustawieniach strony albo wskaż start na mapie.",
                    "timeout" => "Nie udało się ustalić lokalizacji na czas. Spróbuj ponownie albo wskaż start na mapie.",
                    "unsupported" => "Ta przeglądarka nie udostępnia lokalizacji. Wskaż start na mapie.",
                    _ => "Lokalizacja jest teraz niedostępna. Spróbuj ponownie albo wskaż start na mapie."
                };
            }
        }
        finally
        {
            _locating = false;
        }
    }

    private void RemoveStartLocation()
    {
        State.SetStartLocation(null);
        _pickingStart = false;
        _plan = null;
        _error = null;
    }

    private async Task ClearAsync()
    {
        var cleared = await State.ClearPlanAsync();
        _plan = null;
        _error = cleared.Error;
        _locationError = null;
        _pickingStart = false;
        await LoadSelectedAsync();
    }

    private async Task BuildAsync()
    {
        if (_building)
            return;

        _building = true;
        _plan = null;
        _error = null;
        await Task.Yield();     // pokaż loader, zanim zaczną się obliczenia
        try
        {
            var result = await Sender.Send(new BuildTripPlanCommand(
                State.CityId, State.PlanPlaceIds, State.Profile, State.Mode, DateTime.Now, State.StartLocation, State.OptimizeOrder));
            if (result.IsFailure)
            {
                _error = result.Error;
                return;
            }

            ShowPlan(result.Value);
        }
        finally
        {
            _building = false;
        }
    }

    private void ShowPlan(TripPlan plan)
    {
        _plan = plan;
        var count = plan.Stops.Count;
        // Ten sam punkt może leżeć przy dwóch odcinkach; na mapie i w podsumowaniu liczymy go raz.
        _hazards = plan.Legs.SelectMany(l => l.Hazards ?? []).DistinctBy(h => h.Hazard.Id).ToList();
        _markers = plan.Stops
            .Select((s, i) => new MapMarker(s.IsUserLocation ? "" : s.Place.Id,
                StopRole(i, count) is { } role ? $"{s.Place.Name} ({role.ToLowerInvariant()})" : s.Place.Name,
                s.Place.Lat, s.Place.Lon, StopColor(i, count), s.Order.ToString()))
            .Concat(_hazards.Select(h => Labels.Marker(h.Hazard) with { Id = "" }))
            .Concat(plan.Legs.SelectMany(l => l.RestStops ?? []).DistinctBy(r => r.PlaceId).Select(r => new MapMarker(
                "", $"Ławka na przerwę (po około {Labels.Distance(r.DistanceFromStartM)} marszu)", r.Lat, r.Lon, RestColor,
                Icon: Labels.MapIcon(PlaceCategory.Bench))))
            .ToList();
        _route = RouteSegments(plan);
    }

    /// <summary>Najpierw dojścia piesze, potem proponowane przejazdy, żeby linie komunikacji były na wierzchu.</summary>
    private static List<MapRouteSegment> RouteSegments(TripPlan plan)
    {
        var walks = plan.Legs.Select(l => new MapRouteSegment(l.Geometry));
        var rides = plan.Legs
            .Where(l => l.Transit is { Status: TransitStatus.Found })
            .SelectMany(l => l.Transit!.Journeys[0].Rides)
            .Select(r => new MapRouteSegment(r.Path, IsTransit: true, $"{Labels.Of(r.Kind)} {r.LineName}"));
        return walks.Concat(rides).ToList();
    }

    private static string StopColor(int index, int count) => index == 0 ? StartColor : index == count - 1 ? EndColor : MiddleColor;

    private static string StopCss(int index, int count) => index == 0 ? "stop-start" : index == count - 1 ? "stop-end" : "";

    // Rola jest też tekstem, żeby start i cel nie były rozróżniane samym kolorem.
    private static string? StopRole(int index, int count) => index == 0 ? "Start" : index == count - 1 ? "Cel" : null;

    private sealed record Position(bool Ok, double Lat, double Lon, string? Reason);
}
