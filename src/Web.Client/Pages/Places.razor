@page "/miejsca"
@using Application.Abstractions
@inject AppState State
@inject ISender Sender
@inject NavigationManager Navigation

<PageTitle>Miejsca</PageTitle>

<div class="places-hero">
    <div class="container">
        <h1>@Labels.Of(State.Mode)</h1>
        <p class="text-secondary">Przeglądaj dostępne dla Ciebie miejsca</p>
    </div>
</div>

<div class="container py-4">
    <div class="places-header mb-4">
        <div class="mode-selector">
            @foreach (var mode in Enum.GetValues<AppMode>())
            {
                <button type="button"
                        class="btn @(State.Mode == mode ? "btn-primary" : "btn-outline-secondary")"
                        aria-pressed="@(State.Mode == mode ? "true" : "false")"
                        @onclick="() => SetModeAsync(mode)">
                    @(mode == AppMode.Sightseeing ? "🏛️" : "🏪")
                    @Labels.Of(mode)
                </button>
            }
        </div>
        <div class="profile-badge">
            <small class="text-muted">Profil:</small>
            <ProfileSummaryInline />
            <a class="ms-2" href="profil">zmień</a>
        </div>
    </div>

    <CoverageNotice />

    @if (_error is not null)
    {
        <div class="alert alert-danger" role="alert">
            <strong>Błąd:</strong> @_error
        </div>
    }
    else if (_places is null)
    {
        <div class="text-center py-5">
            <div  class="spinner-border text-primary mb-3" role="status">
                <span class="visually-hidden">Wczytuję...</span>
            </div>
            <p role="status">Wczytuję miejsca…</p>
        </div>
    }
    else
    {
        <!-- Statistics -->
        <div class="places-stats mb-4">
            <div class="stat-card accessible">
                <div class="stat-number">@Count(AssessmentStatus.Accessible)</div>
                <div class="stat-label">dostępnych</div>
            </div>
            <div class="stat-card limited">
                <div class="stat-number">@Count(AssessmentStatus.Limited)</div>
                <div class="stat-label">ograniczone</div>
            </div>
            <div class="stat-card inaccessible">
                <div class="stat-number">@Count(AssessmentStatus.Inaccessible)</div>
                <div class="stat-label">niedostępne</div>
            </div>
            <div class="stat-card unknown">
                <div class="stat-number">@Count(AssessmentStatus.Unknown)</div>
                <div class="stat-label">bez danych</div>
            </div>
        </div>

        <!-- Main Grid -->
        <div class="places-grid">
            <div class="places-sidebar">
                <div class="filter-section">
                    <h3 class="filter-title">Filtry</h3>
                    <div class="form-group">
                        <label class="form-label" for="search">Szukaj</label>
                        <input id="search" class="form-control" type="search" placeholder="np. Muzeum, kawiarnia…"
                               @bind="_search" @bind:after="FilterChangedAsync" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="category">Kategoria</label>
                        <select id="category" class="form-select" @bind="_category" @bind:after="FilterChangedAsync">
                            <option value="">Wszystkie kategorie</option>
                            @foreach (var category in ModeCategories.For(State.Mode).Concat(ModeCategories.Support).Where(_counts.ContainsKey))
                            {
                                <option value="@category">@Labels.Of(category) (@_counts[category])</option>
                            }
                        </select>
                    </div>
                    @if (_certified.Count > 0)
                    {
                        <div class="form-check mt-3">
                            <input id="only-certified" class="form-check-input" type="checkbox" @bind="_onlyCertified" @bind:after="FilterChangedAsync" />
                            <label class="form-check-label" for="only-certified">Tylko z certyfikatem (@_certified.Count)</label>
                        </div>
                    }
                    <p class="small text-muted mt-3" role="status">
                        W widocznym obszarze mapy: <strong>@_visible.Count</strong> z @_places.Count miejsc.
                        Przesuń lub powiększ mapę, żeby zmienić obszar.
                    </p>
                    @if (_visible.Count < _places.Count)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ShowAllAsync">Pokaż wszystkie na mapie</button>
                    }
                    @if (_certified.Count > 0)
                    {
                        <p class="small text-muted mt-3 mb-0">
                            <span aria-hidden="true">★</span> Pinezka z gwiazdką w złotej obwódce to miejsce z certyfikatem:
                            firma zatwierdzona przez urząd sama podaje swoje udogodnienia.
                        </p>
                    }
                    <p class="small text-muted mt-3 mb-0">
                        @if (_hazardMarkers.Count > 0)
                        {
                            <text><span aria-hidden="true">⚠️</span> Symbole na mapie to utrudnienia potwierdzone przez urząd (@_hazardMarkers.Count). </text>
                        }
                        Widzisz przeszkodę, hałas albo tłum? <a href="zglos">Zgłoś na mapie</a>.
                    </p>
                </div>
            </div>

            <div class="places-content">
                <div class="places-list">
                    @if (_visible.Count == 0)
                    {
                        <div class="alert alert-info" role="status">
                            @(_places.Count == 0
                                ? "Nie znaleźliśmy miejsc dla tych filtrów."
                                : "W widocznym obszarze mapy nie ma miejsc dla tych filtrów. Oddal mapę albo pokaż wszystkie.")
                        </div>
                    }
                    @foreach (var item in _visible.Take(_shown))
                    {
                        <div class="place-card">
                            <div class="place-card-header">
                                <div>
                                    <a class="place-card-title" href="miejsca/@item.Place.Id">@item.Place.Name</a>
                                    <div class="place-card-meta">
                                        <span class="place-category">@Labels.Of(item.Place.Category)</span>
                                        @if (item.Place.Certificate is not null)
                                        {
                                            <span class="certified-badge"><span aria-hidden="true">★</span> Certyfikat</span>
                                        }
                                        @if (item.Place.Address is not null)
                                        {
                                            <span class="place-address">@item.Place.Address</span>
                                        }
                                    </div>
                                </div>
                                <AssessmentBadge Status="item.Assessment.Status" />
                            </div>

                            @if (FirstReason(item) is { } reason)
                            {
                                <div class="place-card-reason">
                                    @reason
                                </div>
                            }

                            <div class="place-card-footer">
                                <button type="button"
                                        class="btn btn-sm @(State.IsInPlan(item.Place.Id) ? "btn-success" : "btn-primary")"
                                        aria-label="@(State.IsInPlan(item.Place.Id) ? "Usuń z planu" : "Dodaj do planu"): @item.Place.Name"
                                        @onclick="() => State.TogglePlaceAsync(item.Place.Id)">
                                    @if (State.IsInPlan(item.Place.Id))
                                    {
                                        <span>✓ W planie</span>
                                    }
                                    else
                                    {
                                        <span>+ Do planu</span>
                                    }
                                </button>
                                <a class="btn btn-sm btn-outline-secondary" href="miejsca/@item.Place.Id">
                                    Szczegóły
                                </a>
                            </div>
                        </div>
                    }
                </div>

                @if (_visible.Count > _shown)
                {
                    <div class="text-center mt-4">
                        <button type="button" class="btn btn-secondary" @onclick="() => _shown += PageSize">
                            Pokaż więcej (@(_visible.Count - _shown) pozostałych)
                        </button>
                    </div>
                }
            </div>

            <div class="places-map">
                <MapView @ref="_map" Markers="_markers" Center="_center" Zoom="_zoom" FitToMarkers="_fitToResults"
                         OnMarkerSelected="OpenDetails" OnBoundsChanged="OnBoundsChanged" />
            </div>
        </div>
    }
</div>

@code {
    private const int PageSize = 20;
    private const string HazardMarkerPrefix = "hazard:";
    private IReadOnlyList<AssessedPlace>? _places;
    private IReadOnlyList<AssessedPlace> _visible = [];
    private MapView? _map;
    private GeoBounds? _bounds;
    private GeoPoint _center = new(50.0614, 19.9366);
    private int _zoom = 14;
    private bool _fitToResults;
    private IReadOnlyList<MapMarker> _markers = [];
    private IReadOnlyList<MapMarker> _hazardMarkers = [];
    private IReadOnlyList<CertifiedPlace> _certified = [];
    private bool _onlyCertified;
    private Dictionary<PlaceCategory, int> _counts = [];
    private string? _error;
    private string? _search;
    private string _category = "";
    private int _shown = PageSize;

    protected override async Task OnInitializedAsync()
    {
        await State.EnsureLoadedAsync();
        _search = State.PlacesSearch;
        _category = State.PlacesCategory;
        if (State.City is { } city)
        {
            _center = new GeoPoint(city.Lat, city.Lon);
            _zoom = city.Zoom;
        }

        var counts = await Sender.Send(new GetPlaceCategoriesQuery(State.CityId));
        if (counts.IsSuccess)
            _counts = counts.Value.ToDictionary(c => c.Category, c => c.Count);

        // Bez odpowiedzi hosta mapa pokazuje same miejsca.
        var hazards = await Sender.Send(new GetVerifiedHazardsQuery(State.CityId));
        if (hazards.IsSuccess)
            _hazardMarkers = hazards.Value.Select(h => Labels.Marker(h, HazardMarkerPrefix)).ToList();
        var certified = await Sender.Send(new GetCertifiedPlacesQuery(State.CityId));
        if (certified.IsSuccess)
            _certified = certified.Value;
        await LoadAsync();
    }

    /// <summary>Pierwszy widok to centrum miasta; po zmianie filtrów mapa dopasowuje się do wyników.</summary>
    private Task FilterChangedAsync()
    {
        _fitToResults = true;
        return LoadAsync();
    }

    private async Task SetModeAsync(AppMode mode)
    {
        _category = "";
        await State.SetModeAsync(mode);
        await FilterChangedAsync();
    }

    private async Task LoadAsync()
    {
        State.PlacesSearch = _search;
        State.PlacesCategory = _category;
        PlaceCategory? category = Enum.TryParse<PlaceCategory>(_category, out var parsed) ? parsed : null;
        var result = _onlyCertified && category is null
            ? await LoadCertifiedAsync()
            : await Sender.Send(new GetPlacesQuery(State.CityId, State.Mode, State.Profile, category, _search));
        if (result.IsFailure)
        {
            _error = result.Error;
            return;
        }

        _error = null;
        _shown = PageSize;
        _places = _onlyCertified ? result.Value.Where(p => p.Place.Certificate is not null).ToList() : result.Value;
        // Tysiące symboli (np. wszystkie ławki) zatrzymałyby mapę, więc duże zbiory rysujemy kółkami.
        var icons = _places.Count <= Labels.MaxIconMarkers;
        _markers = _places
            .Select(p => p.Place.Certificate is null
                ? new MapMarker(p.Place.Id, $"{p.Place.Name} ({Labels.Of(p.Assessment.Status)})", p.Place.Lat, p.Place.Lon, Labels.Color(p.Assessment.Status),
                    Icon: icons ? Labels.MapIcon(p.Place.Category) : null)
                : new MapMarker(p.Place.Id, $"{p.Place.Name} ({Labels.Of(p.Assessment.Status)}, {Labels.CertifiedSuffix})", p.Place.Lat, p.Place.Lon,
                    Labels.Color(p.Assessment.Status), Certified: true))
            .Concat(CertifiedOutsideResults(_places))
            .Concat(_hazardMarkers)
            .ToList();
        UpdateVisible();
    }

    /// <summary>
    /// Miejsca z certyfikatem spoza kategorii bieżącego trybu (np. hotel w trybie "Zwiedzam") są na mapie zawsze,
    /// o ile użytkownik nie zawęził wyników kategorią albo wyszukiwaniem. Bez oceny, bo nie ma ich na liście.
    /// </summary>
    private IEnumerable<MapMarker> CertifiedOutsideResults(IReadOnlyList<AssessedPlace> places)
    {
        if (_category != "" || !string.IsNullOrWhiteSpace(_search))
            return [];

        var listed = places.Select(p => p.Place.Id).ToHashSet();
        return _certified
            .Where(c => !listed.Contains(c.PlaceId))
            .Select(c => new MapMarker(c.PlaceId, $"{c.PlaceName} ({Labels.Of(c.Category)}, {Labels.CertifiedSuffix})", c.Lat, c.Lon,
                Labels.Color(AssessmentStatus.Unknown), Certified: true));
    }

    /// <summary>
    /// Filtr "tylko z certyfikatem" bez wybranej kategorii obejmuje wszystkie kategorie, w których są takie miejsca,
    /// także spoza bieżącego trybu: hotel z certyfikatem ma być na liście również w trybie "Zwiedzam".
    /// </summary>
    private async Task<Result<IReadOnlyList<AssessedPlace>>> LoadCertifiedAsync()
    {
        var places = new List<AssessedPlace>();
        foreach (var category in _certified.Select(c => c.Category).Distinct())
        {
            var result = await Sender.Send(new GetPlacesQuery(State.CityId, State.Mode, State.Profile, category, _search));
            if (result.IsFailure)
                return result;
            places.AddRange(result.Value);
        }
        return Result.Success<IReadOnlyList<AssessedPlace>>(places.OrderByDescending(p => p.Score).ToList());
    }

    /// <summary>Lista i statystyki pokazują tylko to, co widać na mapie.</summary>
    private void OnBoundsChanged(GeoBounds bounds)
    {
        _bounds = bounds;
        _shown = PageSize;
        UpdateVisible();
    }

    private void UpdateVisible() => _visible = _places is null ? []
        : _bounds is { } bounds ? _places.Where(p => bounds.Contains(p.Place.Location)).ToList()
        : _places;

    private async Task ShowAllAsync()
    {
        if (_map is not null)
            await _map.ShowAllMarkersAsync();
    }

    private int Count(AssessmentStatus status) => _visible.Count(p => p.Assessment.Status == status);

    private static string? FirstReason(AssessedPlace item) =>
        (item.Assessment.Barriers.FirstOrDefault() ?? item.Assessment.Reasons.FirstOrDefault())?.Message;

    private void OpenDetails(string id)
    {
        // Utrudnienie nie ma karty: jego opis jest w nazwie pinezki.
        if (!id.StartsWith(HazardMarkerPrefix))
            Navigation.NavigateTo($"miejsca/{id}");
    }
}
