@inherits LayoutComponentBase
@implements IDisposable
@inject AppState State

<a class="visually-hidden-focusable skip-link" href="#tresc">Przejdź do treści</a>

<header class="app-header">
    <nav class="navbar navbar-expand navbar-dark container-fluid" aria-label="Główna nawigacja">
        <a class="navbar-brand fw-bold" href="">Kraków bez barier</a>
        <ul class="navbar-nav flex-wrap">
            <li class="nav-item"><NavLink class="nav-link" href="profil">Profil</NavLink></li>
            <li class="nav-item"><NavLink class="nav-link" href="miejsca">Miejsca</NavLink></li>
            <li class="nav-item">
                <NavLink class="nav-link" href="plan">Plan <span class="badge text-bg-light">@State.PlanPlaceIds.Count</span></NavLink>
            </li>
        </ul>
    </nav>
</header>

<main id="tresc" class="container py-3">
    @Body
</main>

<footer class="container py-3 small text-body-secondary">
    Dane o miejscach: © autorzy OpenStreetMap (licencja ODbL). Cechy oznaczone jako „dane demonstracyjne” nie są zweryfikowane.
    Profil potrzeb jest zapisany tylko na tym urządzeniu.
</footer>

<div id="blazor-error-ui" data-nosnippet>
    Wystąpił nieoczekiwany błąd.
    <a href="." class="reload">Odśwież</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        State.Changed += StateHasChanged;
        await State.EnsureLoadedAsync();
    }

    public void Dispose() => State.Changed -= StateHasChanged;
}
