@page "/konto"
@page "/konto/{Section}"
@page "/zgloszenia"
@using System.Text.RegularExpressions
@inject AppState State
@inject ISender Sender
@inject NavigationManager Navigation

<PageTitle>Konto</PageTitle>

@if (!_loaded)
{
    <h1>Konto</h1>
    <p role="status">Wczytuję…</p>
}
else if (State.User is { } user)
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="mb-0">Konto</h1>
            <p class="text-body-secondary mb-0">Zalogowano jako <strong>@user.Login</strong></p>
        </div>
        <button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="LogoutAsync">Wyloguj</button>
    </div>

    <ul class="nav nav-tabs mb-3" aria-label="Sekcje konta">
        <li class="nav-item">
            <a class="nav-link @(ShowsProfile ? "" : "active")" aria-current="@(ShowsProfile ? null : "page")" href="konto">
                Moje zgłoszenia
                @if (_loadedFor is not null)
                {
                    <span class="badge text-bg-light border ms-1">@(_reports.Count + _hazards.Count)</span>
                }
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(ShowsProfile ? "active" : "")" aria-current="@(ShowsProfile ? "page" : null)" href="konto/profil">Profil potrzeb</a>
        </li>
    </ul>

    @if (ShowsProfile)
    {
        <p class="text-body-secondary">
            Profil konta: według niego oceniamy miejsca i układamy trasy, gdy jesteś zalogowany.
            Jest zapisany na tym urządzeniu i przypisany do konta; nie wysyłamy go na serwer, więc na innym urządzeniu ustawisz go osobno.
        </p>
        <ProfileEditor SaveLabel="Zapisz profil" Note="Profil konta zostaje na tym urządzeniu. Nie wysyłamy go na serwer." />
    }
    else
    {
        <p class="text-body-secondary">
            Zgłoszenia wysłane z Twojego konta i odpowiedzi urzędu.
            Nowe wyślesz z karty miejsca albo z zakładki <a href="zglos">Zgłoś na mapie</a>.
        </p>

        @if (_loadedFor is null && _error is null)
        {
            <p role="status">Wczytuję zgłoszenia…</p>
        }
        else if (_error is not null)
        {
            <div class="alert alert-warning" role="alert">@_error</div>
        }
        else if (_reports.Count == 0 && _hazards.Count == 0)
        {
            <div class="alert alert-info">
                Nie masz jeszcze żadnego zgłoszenia. Otwórz <a href="miejsca">kartę miejsca</a> i użyj przycisku „Zgłoś”
                albo zaznacz utrudnienie w zakładce <a href="zglos">Zgłoś na mapie</a>.
            </div>
        }
        else
        {
            @if (_reports.Count > 0)
            {
                <h2 class="h4">Miejsca</h2>
                <ul class="list-unstyled">
                    @foreach (var report in _reports)
                    {
                        <li class="card card-body mb-3">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                                <h3 class="h5 mb-1"><a href="@($"miejsca/{report.PlaceId}")">@report.PlaceName</a></h3>
                                <ReportStatusBadge Status="report.Status" />
                            </div>
                            <p class="small text-body-secondary mb-2">Wysłane @Labels.When(report.CreatedAt)</p>
                            <p class="mb-1"><strong>@Labels.Of(report.Kind)</strong>@(report.Features.Count > 0 ? $": {Labels.Features(report.Features)}" : "")</p>
                            @if (report.OfficialNote is not null)
                            {
                                <div class="border-start border-3 ps-3 mt-2">
                                    <p class="small text-body-secondary mb-1">Odpowiedź urzędu, @Labels.When(report.UpdatedAt)</p>
                                    <p class="mb-0">@report.OfficialNote</p>
                                </div>
                            }
                        </li>
                    }
                </ul>
            }

            @if (_hazards.Count > 0)
            {
                <h2 class="h4">Punkty zaznaczone na mapie</h2>
                <ul class="list-unstyled">
                    @foreach (var hazard in _hazards)
                    {
                        <li class="card card-body mb-3">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                                <h3 class="h5 mb-1"><span aria-hidden="true">@Labels.Icon(hazard.Kind)</span> @Labels.Of(hazard.Kind)</h3>
                                <span class="status-badge @Labels.Css(hazard.Status)">@Labels.Of(hazard.Status)</span>
                            </div>
                            <p class="small text-body-secondary mb-2">
                                Wysłane @Labels.When(hazard.CreatedAt) · punkt @hazard.Lat.ToString("F5"), @hazard.Lon.ToString("F5")
                            </p>
                            @if (!string.IsNullOrEmpty(hazard.Description))
                            {
                                <p class="mb-1 report-description">@hazard.Description</p>
                            }
                            @if (hazard.Status == HazardStatus.Verified)
                            {
                                <p class="mb-1">Punkt jest widoczny na mapie i ostrzega w planach tras.</p>
                            }
                            @if (hazard.OfficialNote is not null)
                            {
                                <div class="border-start border-3 ps-3 mt-2">
                                    <p class="small text-body-secondary mb-1">Odpowiedź urzędu, @Labels.When(hazard.UpdatedAt)</p>
                                    <p class="mb-0">@hazard.OfficialNote</p>
                                </div>
                            }
                        </li>
                    }
                </ul>
            }
        }
    }
}
else
{
    <h1>Konto</h1>
    <p class="text-body-secondary">
        Z kontem wysyłasz zgłoszenia do urzędu, śledzisz odpowiedzi i masz zapisany profil potrzeb.
        Wystarczy login i hasło: nie pytamy o e-mail ani imię. Miejsca i plan trasy działają też bez logowania.
    </p>

    <div class="mode-selector mb-3" role="group" aria-label="Logowanie albo rejestracja">
        <button type="button" class="btn @(_registering ? "btn-outline-secondary" : "btn-primary")"
                aria-pressed="@(_registering ? "false" : "true")" @onclick="() => Switch(false)">Mam konto</button>
        <button type="button" class="btn @(_registering ? "btn-primary" : "btn-outline-secondary")"
                aria-pressed="@(_registering ? "true" : "false")" @onclick="() => Switch(true)">Zakładam konto</button>
    </div>

    <form class="card card-body official-login" @onsubmit="SubmitAsync" @onsubmit:preventDefault novalidate>
        <h2 class="h5">@(_registering ? "Nowe konto" : "Logowanie")</h2>
        <div class="mb-3">
            <label class="form-label" for="account-login">Login</label>
            <input id="account-login" class="form-control" autocomplete="username" autocapitalize="none" spellcheck="false"
                   maxlength="@UserCredentials.MaxLoginLength" aria-describedby="@(_registering ? "account-login-help" : null)" @bind="_login" />
            @if (_registering)
            {
                <div id="account-login-help" class="form-text">
                    Od @UserCredentials.MinLoginLength do @UserCredentials.MaxLoginLength znaków: litery bez polskich znaków, cyfry, kropka, myślnik, podkreślenie.
                    Urząd zobaczy go przy Twoich zgłoszeniach, więc nie musi to być imię i nazwisko.
                </div>
            }
        </div>
        <div class="mb-3">
            <label class="form-label" for="account-password">Hasło</label>
            <input id="account-password" type="password" class="form-control" autocomplete="@(_registering ? "new-password" : "current-password")"
                   maxlength="@UserCredentials.MaxPasswordLength" aria-describedby="@(_registering ? "account-password-help" : null)" @bind="_password" />
            @if (_registering)
            {
                <div id="account-password-help" class="form-text">
                    Co najmniej @UserCredentials.MinPasswordLength znaków. Zapamiętaj je: bez adresu e-mail nie możemy przypomnieć hasła.
                </div>
            }
        </div>
        @if (_registering)
        {
            <div class="mb-3">
                <label class="form-label" for="account-password-repeat">Powtórz hasło</label>
                <input id="account-password-repeat" type="password" class="form-control" autocomplete="new-password"
                       maxlength="@UserCredentials.MaxPasswordLength" @bind="_repeat" />
            </div>
        }
        @if (_error is not null)
        {
            <div class="alert alert-danger" role="alert">@_error</div>
        }
        <button type="submit" class="btn btn-primary" disabled="@_busy">
            @(_busy ? "Chwileczkę…" : _registering ? "Załóż konto" : "Zaloguj")
        </button>
    </form>
}

@code {
    private const string ProfileSection = "profil";

    private bool _loaded;
    private bool _registering;
    private bool _busy;
    private string _login = "";
    private string _password = "";
    private string _repeat = "";
    private string? _error;

    /// <summary>Login konta, dla którego wczytano zgłoszenia; null przed wczytaniem.</summary>
    private string? _loadedFor;
    private IReadOnlyList<ReportStatusView> _reports = [];
    private IReadOnlyList<HazardStatusView> _hazards = [];

    /// <summary>Sekcja z adresu: "profil" albo brak (zgłoszenia).</summary>
    [Parameter] public string? Section { get; set; }

    /// <summary>Strona, na którą wracamy po zalogowaniu, np. formularz zgłoszenia.</summary>
    [SupplyParameterFromQuery(Name = "powrot")] public string? ReturnTo { get; set; }

    /// <summary>Otwiera od razu formularz rejestracji (odnośniki "Załóż konto").</summary>
    [SupplyParameterFromQuery(Name = "nowe")] public bool StartRegistering { get; set; }

    private bool ShowsProfile => string.Equals(Section, ProfileSection, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        await State.EnsureLoadedAsync();
        _registering = StartRegistering;
        _loaded = true;
        await LoadReportsAsync();
    }

    private async Task LoadReportsAsync()
    {
        if (State.User is not { } user || _loadedFor == user.Login)
            return;

        var reports = await Sender.Send(new GetMyReportsQuery());
        var hazards = await Sender.Send(new GetMyHazardsQuery());
        if (reports.IsSuccess && hazards.IsSuccess)
        {
            (_reports, _hazards, _loadedFor, _error) = (reports.Value, hazards.Value, user.Login, null);
        }
        else
        {
            _error = reports.Error ?? hazards.Error;
        }
    }

    private void Switch(bool registering)
    {
        _registering = registering;
        _error = null;
    }

    private async Task SubmitAsync()
    {
        if (_registering && _password != _repeat)
        {
            _error = "Hasła nie są takie same.";
            return;
        }

        _busy = true;
        _error = null;
        var credentials = new UserCredentials(_login, _password);
        var result = _registering
            ? await Sender.Send(new RegisterUserCommand(credentials))
            : await Sender.Send(new LoginUserCommand(credentials));
        _busy = false;

        if (result.IsFailure)
        {
            _error = result.Error;
            return;
        }

        _password = _repeat = "";
        await State.SetUserAsync(result.Value);
        if (SafeReturnTo() is { } target)
            Navigation.NavigateTo(target);
        else
            await LoadReportsAsync();
    }

    private async Task LogoutAsync()
    {
        _busy = true;
        await Sender.Send(new LogoutUserCommand());
        _busy = false;
        (_reports, _hazards, _loadedFor) = ([], [], null);
        await State.SetUserAsync(null);
    }

    /// <summary>Tylko ścieżka wewnątrz aplikacji: parametr z adresu nie może wyprowadzić na obcą stronę.</summary>
    private string? SafeReturnTo() =>
        ReturnTo is not null && Regex.IsMatch(ReturnTo, "^[a-z0-9][a-z0-9/_-]{0,100}$", RegexOptions.IgnoreCase) ? ReturnTo : null;
}
