@page "/miejsca/{Id}"
@inject AppState State
@inject ISender Sender
@inject NavigationManager Navigation

<PageTitle>@(_item?.Place.Name ?? "Miejsce")</PageTitle>

@if (_error is not null)
{
    <h1>Miejsce</h1>
    <div class="alert alert-danger" role="alert">@_error</div>
}
else if (_item is null)
{
    <p role="status">Wczytuję…</p>
}
else
{
    var place = _item.Place;
    <div class="page-header">
        <h1>@place.Name</h1>
        <p>@Labels.Of(place.Category)@(place.Address is null ? "" : $" · {place.Address}")</p>
    </div>

    <CoverageNotice />

    @if (place.Certificate is { } certificate)
    {
        <section class="card card-body mb-3" aria-labelledby="place-certificate">
            <h2 id="place-certificate" class="h5">
                <span class="certified-badge"><span class="msym msym-fill" aria-hidden="true">verified</span> Certyfikat Kraków bez barier</span>
            </h2>
            <p class="mb-1">
                To miejsce prowadzi firma <strong>@certificate.BusinessName</strong>, zatwierdzona przez urząd.
                Certyfikat nr <strong>@certificate.CertificateId</strong>, wydany @Labels.Day(certificate.IssuedAt).
            </p>
            <p class="small text-body-secondary mb-0">
                Cechy ze źródłem „@CertifiedPlace.FeatureSource” podaje i aktualizuje sama firma.
                Coś się nie zgadza? Użyj przycisku „Zgłoś” niżej.
            </p>
        </section>
    }

    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <AssessmentBadge Status="_item.Assessment.Status" />
        <span>dla profilu: <ProfileSummaryInline /></span>
        <button type="button" class="btn @(State.IsInPlan(place.Id) ? "btn-success" : "btn-primary")"
                aria-pressed="@(State.IsInPlan(place.Id) ? "true" : "false")" @onclick="() => TogglePlanAsync(place.Id)">
            <span class="msym" aria-hidden="true">@(State.IsInPlan(place.Id) ? "check" : "add")</span>
            @(State.IsInPlan(place.Id) ? "W planie (usuń)" : "Dodaj do planu")
        </button>
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <section class="card card-body">
                <h2 class="h5">Dlaczego taka ocena</h2>
                <ReasonList Assessment="_item.Assessment" />
            </section>

            @if (place.Description is not null)
            {
                <section class="card card-body mt-3">
                    <h2 class="h5">Opis</h2>
                    <p class="mb-0">@place.Description</p>
                </section>
            }

            <section class="card card-body mt-3">
                <h2 class="h5">Wszystkie znane cechy</h2>
                @if (place.Features.Count == 0)
                {
                    <p class="mb-0">Nie mamy żadnych danych o dostępności tego miejsca. Brak danych nie oznacza, że miejsce jest dostępne.</p>
                }
                else
                {
                    <div class="table-responsive" tabindex="0" role="region" aria-label="Tabela cech miejsca">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th scope="col">Cecha</th><th scope="col">Wartość</th><th scope="col">Źródło</th><th scope="col">Stan na dzień</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var feature in place.Features)
                            {
                                <tr>
                                    <th scope="row" class="fw-normal">@Labels.Of(feature.Key)</th>
                                    <td>@Labels.Value(feature)</td>
                                    <td>@feature.Source</td>
                                    <td>@feature.CheckedOn?.ToString("dd.MM.yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                }
            </section>

            <ReportForm Place="place" />

            @if (place.Certificate is null && BusinessApplicationDraft.IsEligible(place.Category))
            {
                <p class="small text-body-secondary mt-3 mb-0">
                    Prowadzisz to miejsce? <a href="@($"konto/firma?miejsce={Uri.EscapeDataString(place.Id)}")">Załóż konto firmowe</a>,
                    żeby samodzielnie oznaczać udogodnienia i dostać certyfikat z kodem QR.
                </p>
            }
        </div>
        <div class="col-lg-6">
            <MapView Label="@($"Położenie: {place.Name}")" Center="place.Location" Zoom="17" Markers="_markers" />
        </div>
    </div>

    <p class="mt-3"><a class="back-link" href="miejsca"><span class="msym" aria-hidden="true">arrow_back</span>Wróć do listy miejsc</a></p>
}

@code {
    private AssessedPlace? _item;
    private IReadOnlyList<MapMarker> _markers = [];
    private string? _error;

    [Parameter] public string Id { get; set; } = "";

    /// <summary>Miasto z adresu (kod QR na certyfikacie): skanujący może mieć w aplikacji wybrane inne.</summary>
    [SupplyParameterFromQuery(Name = "miasto")] public string? CityFromLink { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await State.EnsureLoadedAsync();
        var cityId = State.Cities.Any(c => c.Id == CityFromLink) ? CityFromLink! : State.CityId;
        var result = await Sender.Send(new GetPlaceDetailsQuery(cityId, Id, State.Profile));
        if (result.IsFailure)
        {
            _error = result.Error;
            return;
        }

        _item = result.Value;
        _markers = [new MapMarker(_item.Place.Id, _item.Place.Name, _item.Place.Lat, _item.Place.Lon, Labels.Color(_item.Assessment.Status),
            Icon: Labels.MapIcon(_item.Place.Category), Certified: _item.Place.Certificate is not null)];
    }

    /// <summary>Po dodaniu wracamy do listy, żeby wybierać dalej; po usunięciu zostajemy na karcie miejsca.</summary>
    private async Task TogglePlanAsync(string placeId)
    {
        var adding = !State.IsInPlan(placeId);
        await State.TogglePlaceAsync(placeId);
        if (adding)
            Navigation.NavigateTo("miejsca");
    }
}
