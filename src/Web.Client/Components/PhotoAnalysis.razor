@inject ISender Sender
@inject IJSRuntime JS

<fieldset class="photo-analysis mb-3" aria-describedby="@($"{IdPrefix}-help")">
    <legend class="h6">Zdjęcie (opcjonalnie)</legend>
    <p id="@($"{IdPrefix}-help")" class="form-text mt-0">
        Zrób albo dodaj zdjęcie, a AI oceni, czy widać na nim przeszkodę. Zdjęcie wysyłamy do analizy w OpenAI,
        a jego zmniejszoną kopię dołączamy do zgłoszenia: zobaczy ją urzędnik i Ty na stronie Konto, nikt inny.
        Dane o lokalizacji usuwamy ze zdjęcia jeszcze w przeglądarce. Unikaj fotografowania twarzy i tablic rejestracyjnych.
    </p>

    @* Pola wyboru pliku muszą zostać w DOM na czas analizy: Blazor czyta plik z elementu input, więc po jego usunięciu odczyt się wywala. *@
    <div class="photo-picker" hidden="@_busy">
        <InputFile id="@($"{IdPrefix}-camera")" class="visually-hidden" accept="image/*" capture="environment" OnChange="OnSelectedAsync" />
        <label class="btn btn-outline-primary" for="@($"{IdPrefix}-camera")"><span aria-hidden="true">📷</span> Zrób zdjęcie</label>
        <InputFile id="@($"{IdPrefix}-file")" class="visually-hidden" accept="image/*" OnChange="OnSelectedAsync" />
        <label class="btn btn-outline-secondary" for="@($"{IdPrefix}-file")"><span aria-hidden="true">🖼️</span> Wybierz z urządzenia</label>
        @if (_preview is not null)
        {
            <button type="button" class="btn btn-link" @onclick="Clear">Usuń zdjęcie</button>
        }
    </div>

    @if (_preview is not null)
    {
        <img class="photo-preview" src="@_preview" alt="Podgląd dodanego zdjęcia" />
    }

    <div role="status" aria-live="polite">
        @if (_busy)
        {
            <p class="mb-0 mt-2"><span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span> Analizuję zdjęcie…</p>
        }
        else if (_analysis is { } analysis)
        {
            <div class="photo-verdict photo-verdict-@analysis.Verdict.ToString().ToLowerInvariant()">
                <strong><span aria-hidden="true">@Icon(analysis.Verdict)</span> @Label(analysis.Verdict)</strong>
                <div>Prawdopodobieństwo przeszkody według AI: <strong>@analysis.Percent%</strong></div>
                <div class="photo-meter" aria-hidden="true"><span style="width: @(analysis.Percent)%"></span></div>
                @if (analysis.SuggestedKind is { } kind)
                {
                    <div>Rodzaj: @Labels.Of(kind)</div>
                }
                @if (!string.IsNullOrEmpty(analysis.Summary))
                {
                    <div class="report-description">„@analysis.Summary”</div>
                }
                <div class="form-text">Ocena AI może się mylić. Sprawdź ją, zanim wyślesz zgłoszenie.</div>
                @if (OnApply.HasDelegate && analysis.Verdict != ObstacleVerdict.Unlikely)
                {
                    <button type="button" class="btn btn-sm btn-outline-primary mt-2" @onclick="() => OnApply.InvokeAsync(analysis)">
                        Uzupełnij zgłoszenie na podstawie zdjęcia
                    </button>
                }
            </div>
        }
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-warning mt-2 mb-0" role="alert">@_error</div>
    }
    @if (_preview is not null && !_busy)
    {
        <p class="form-text mb-0" role="status">
            @(_attachment is { } attached
                ? $"Zdjęcie zostanie dołączone do zgłoszenia (zmniejszone do {Math.Max(1, attached.Length / 1024)} KB)."
                : "Tego zdjęcia nie udało się zmniejszyć, więc nie zostanie dołączone do zgłoszenia.")
        </p>
    }
</fieldset>

@code {
    private bool _busy;
    private string? _preview;
    private ObstacleAnalysis? _analysis;
    private string? _error;
    private byte[]? _attachment;

    /// <summary>Przedrostek identyfikatorów pól, gdy na stronie jest więcej niż jeden formularz.</summary>
    [Parameter] public string IdPrefix { get; set; } = "photo";

    /// <summary>Gdy podane, wynik można jednym przyciskiem przenieść do formularza zgłoszenia.</summary>
    [Parameter] public EventCallback<ObstacleAnalysis> OnApply { get; set; }

    /// <summary>
    /// Zdjęcie do dołączenia do zgłoszenia: zmniejszona kopia z oceną AI (bez oceny, dopóki analiza trwa albo gdy się nie udała);
    /// null po usunięciu zdjęcia.
    /// </summary>
    [Parameter] public EventCallback<PhotoAttachment?> OnPhotoChanged { get; set; }

    private async Task OnSelectedAsync(InputFileChangeEventArgs e)
    {
        _error = null;
        _analysis = null;
        _attachment = null;
        await OnPhotoChanged.InvokeAsync(null);
        if (!e.File.ContentType.StartsWith("image/", StringComparison.Ordinal))
        {
            _error = "Wybierz plik ze zdjęciem.";
            return;
        }

        _busy = true;
        try
        {
            // Zmniejszenie i zapis jako JPEG w przeglądarce: szybsza wysyłka, a przy okazji znika EXIF z położeniem GPS.
            var resized = await e.File.RequestImageFileAsync("image/jpeg", PhotoUpload.MaxDimensionPx, PhotoUpload.MaxDimensionPx);
            await using var stream = resized.OpenReadStream(PhotoUpload.MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);

            var photo = new PhotoUpload(buffer.ToArray(), "image/jpeg");
            _preview = $"data:image/jpeg;base64,{Convert.ToBase64String(photo.Content)}";
            StateHasChanged();

            // Kopia do bazy jest dużo mniejsza niż wersja dla modelu: urzędnik ma zobaczyć przeszkodę, nie szczegóły.
            _attachment = await ShrinkAsync(photo.Content);
            await NotifyAsync();

            var result = await Sender.Send(new AnalyzePhotoCommand(photo));
            if (result.IsSuccess)
                _analysis = result.Value;
            else
                _error = result.Error;
            await NotifyAsync();
        }
        catch (Exception ex) when (ex is IOException or JSException or InvalidOperationException)
        {
            _preview = null;
            _error = "Nie udało się odczytać zdjęcia. Spróbuj innego pliku (JPEG, PNG lub WebP).";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<byte[]?> ShrinkAsync(byte[] content)
    {
        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/photo.js");
            return await module.InvokeAsync<byte[]?>("shrink", content, PhotoAttachment.MaxDimensionPx, PhotoAttachment.MaxBytes);
        }
        catch (JSException)
        {
            return null;
        }
    }

    private Task NotifyAsync() =>
        OnPhotoChanged.InvokeAsync(_attachment is null ? null : new PhotoAttachment(_attachment, _analysis));

    private async Task Clear()
    {
        _preview = null;
        _analysis = null;
        _error = null;
        _attachment = null;
        await OnPhotoChanged.InvokeAsync(null);
    }

    private static string Label(ObstacleVerdict verdict) => verdict switch
    {
        ObstacleVerdict.Likely => "Na zdjęciu prawdopodobnie jest przeszkoda",
        ObstacleVerdict.Uncertain => "Nie wiadomo, czy na zdjęciu jest przeszkoda",
        _ => "Na zdjęciu raczej nie ma przeszkody"
    };

    private static string Icon(ObstacleVerdict verdict) => verdict switch
    {
        ObstacleVerdict.Likely => "⚠️",
        ObstacleVerdict.Uncertain => "❔",
        _ => "✅"
    };
}
